# =============================================================================
# Mentara monorepo — copy to `.env` at the repository root for Nest/Prisma scripts.
# For Next.js client-only vars, you can also use `apps/web/.env.local` (see below).
# =============================================================================

# --- Required (NestJS startup validation) ---
NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://user:password@localhost:5432/mentara

JWT_SECRET=replace-with-at-least-32-chars-long-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-service-role-or-anon-key-as-used-by-backend

# --- Recommended for production (warnings if missing) ---
FRONTEND_URL=http://localhost:10001
AI_SERVICE_URL=http://localhost:5001

# OAuth callback URLs (must match registered redirect URIs)
GOOGLE_CALLBACK_URL=http://localhost:10000/api/auth/google/callback
MICROSOFT_CALLBACK_URL=http://localhost:10000/api/auth/microsoft/callback

# JWT lifetimes (optional)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Optional: messaging encryption ---
MESSAGE_ENCRYPTION_KEY=replace-with-at-least-32-chars-hex-or-string

# --- Optional: email (EmailJS) ---
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Optional: app / marketing URLs in emails ---
APP_URL=http://localhost:10001
SUPPORT_EMAIL=support@mentara.com
MIN_PASSWORD_LENGTH=8

# --- Optional: AI provider (pre-assessment; see logEnvironmentInfo) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:latest

SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# --- Optional: billing / webhooks / infra ---
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

ALLOWED_ORIGINS=
API_BASE_URL=http://localhost:10000

# Testing
TEST_DATABASE_URL=

# =============================================================================
# Next.js (`apps/web`) — browser-exposed; prefix NEXT_PUBLIC_
# Set in root `.env` or `apps/web/.env.local`
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:10000/api
NEXT_PUBLIC_WS_URL=http://localhost:10000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
